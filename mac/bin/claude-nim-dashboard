  th, td { text-align: left; padding: 4px 8px; border-bottom: 1px solid #21262d; }
  th { color: #7d8590; font-weight: 500; font-size: 11px; letter-spacing: .04em; }
  td.r, th.r { text-align: right; }
  .pill { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 11px; font-weight: 500; }
  .pill.ok    { background: #1f3a26; color: #56d364; }
  .pill.warn  { background: #3a2f0f; color: #e3b341; }
  .pill.err   { background: #3a1f1f; color: #ff7b72; }
  .pill.dim   { background: #21262d; color: #7d8590; }
  .dim { color: #6e7681; }
  .footer { color: #6e7681; font-size: 11px; margin-top: 24px; }
  .modeltag { margin-right: 14px; }
</style>
</head>
<body>
  <h1>claude-nim dashboard</h1>
  <div class=sub id=meta>connecting…</div>

  <div class=grid>
    <div class=card>
      <h2>Rate · last 60s</h2>
      <div class=big><span id=rate_now>0</span><span class=unit>/ %RPM% rpm</span></div>
      <div class=bar><div id=rate_bar style="width:0%; background:#3fb950"></div></div>
      <div class=dim style="font-size:11px;margin-top:6px">NIM free-tier hard cap</div>
    </div>

    <div class=card>
      <h2>Today · requests</h2>
      <div class=big id=today_total>0</div>
      <div id=today_status class=dim style="margin-top:8px;font-size:12px"></div>
    </div>

    <div class=card>
      <h2>Today · tokens</h2>
      <div class=big><span id=today_total_tokens>0</span></div>
      <div class=row><span class=k>input</span>  <span id=today_in>0</span></div>
      <div class=row><span class=k>output</span> <span id=today_out>0</span></div>
    </div>

    <div class=card>
      <h2>Today · latency</h2>
      <div class=row><span class=k>p50</span> <span id=lat_p50>—</span></div>
      <div class=row><span class=k>p95</span> <span id=lat_p95>—</span></div>
      <div class=row><span class=k>avg</span> <span id=lat_avg>—</span></div>
    </div>

    <div class=card>
      <h2>Today · models</h2>
      <div id=today_models class=dim style="font-size:12px;line-height:1.7"></div>
