#!/usr/bin/env python3
"""claude-nim-dashboard — web dashboard for live NIM proxy usage.

Reads ~/.cache/nim-proxy-usage.jsonl (the proxy's usage_logger middleware
writes one line per request) and serves a self-refreshing HTML page on
http://localhost:8083 (or $NIM_DASH_PORT).

  GET /           → single-page dashboard
  GET /api/usage  → one-shot JSON snapshot
  GET /api/stream → Server-Sent Events stream, new snapshot every second

The proxy logs the *Anthropic-style* model name the client requested
(claude-haiku-4-...). The dashboard reads proxy/.env (MODEL_OPUS/SONNET/HAIKU)
and translates each request to the actual served NIM model
(e.g. nvidia_nim/stepfun-ai/step-3.5-flash) so you see what really ran.

No third-party deps — stdlib only. Bound to 127.0.0.1 by default.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
from collections import Counter
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

DEFAULT_LOG = Path(os.path.expanduser("~/.cache/nim-proxy-usage.jsonl"))
DEFAULT_ENV = Path(__file__).resolve().parent.parent.parent / "proxy" / ".env"
NIM_RPM = 40

_ENV_RE = re.compile(r'^([A-Z_][A-Z0-9_]*)\s*=\s*"?([^"\n]*)"?\s*$')


def load_model_map(env_path: Path) -> dict[str, str]:
    """Parse proxy/.env and return {requested-prefix: served-model}.

    Maps Anthropic family prefixes to whatever the proxy will route them to:
      claude-opus-*    -> MODEL_OPUS
      claude-sonnet-*  -> MODEL_SONNET
      claude-3-5-*     -> MODEL_SONNET (legacy alias)
      claude-haiku-*   -> MODEL_HAIKU
      claude-3-haiku-* -> MODEL_HAIKU (legacy)
    """
    vals: dict[str, str] = {}
    if env_path.exists():
        for line in env_path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            m = _ENV_RE.match(line)
            if m and m.group(1) in {"MODEL_OPUS", "MODEL_SONNET", "MODEL_HAIKU", "MODEL"}:
                vals[m.group(1)] = m.group(2)
    return vals


def served_model(requested: str | None, mp: dict[str, str]) -> str | None:
    if not requested:
        return None
    r = requested.lower()
    if "opus" in r:
        return mp.get("MODEL_OPUS") or mp.get("MODEL")
    if "sonnet" in r:
        return mp.get("MODEL_SONNET") or mp.get("MODEL")
    if "haiku" in r:
        return mp.get("MODEL_HAIKU") or mp.get("MODEL")
    return mp.get("MODEL") or requested

INDEX_HTML = """<!doctype html>
<html lang=en>
<head>
<meta charset=utf-8>
<title>claude-nim dashboard</title>
<meta name=viewport content="width=device-width,initial-scale=1">
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body { font: 14px/1.45 -apple-system,BlinkMacSystemFont,"SF Mono",Menlo,monospace;
         margin: 0; padding: 24px; background: #0d1117; color: #e6edf3; }
  h1 { font-size: 18px; margin: 0 0 4px; letter-spacing: .02em; }
  .sub { color: #7d8590; font-size: 12px; margin-bottom: 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 14px 16px; }
  .card h2 { font-size: 11px; color: #7d8590; margin: 0 0 8px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; }
  .big { font-size: 28px; font-weight: 600; line-height: 1.1; }
  .big .unit { font-size: 14px; color: #7d8590; margin-left: 4px; }
  .row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #21262d; }
  .row:last-child { border: 0; }
  .row .k { color: #7d8590; }
