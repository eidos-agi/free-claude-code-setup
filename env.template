# Generated 2026-04-23 — populate NVIDIA_NIM_API_KEY then copy to
# /root/repos/free-claude-code/.env inside WSL.

# === REQUIRED: paste your key from build.nvidia.com/settings/api-keys ===
NVIDIA_NIM_API_KEY=""

# Unused providers (leave blank — routes only to NIM)
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
LM_STUDIO_BASE_URL="http://localhost:1234/v1"
LLAMACPP_BASE_URL="http://localhost:8080/v1"

# Model routing — all three Claude tiers → NIM open-source models
MODEL_OPUS="nvidia_nim/z-ai/glm4.7"
MODEL_SONNET="nvidia_nim/moonshotai/kimi-k2-thinking"
MODEL_HAIKU="nvidia_nim/stepfun-ai/step-3.5-flash"
MODEL="nvidia_nim/z-ai/glm4.7"

# Enable model thinking/reasoning when available
ENABLE_THINKING=true

# Proxies (leave blank)
NVIDIA_NIM_PROXY=""
OPENROUTER_PROXY=""
LMSTUDIO_PROXY=""
LLAMACPP_PROXY=""

# NIM free-tier rate limit: 40 requests per 60 seconds
PROVIDER_RATE_LIMIT=40
PROVIDER_RATE_WINDOW=60
PROVIDER_MAX_CONCURRENCY=5

# HTTP timeouts (seconds)
HTTP_READ_TIMEOUT=120
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=2

# Proxy server auth — client must send this in ANTHROPIC_AUTH_TOKEN
ANTHROPIC_AUTH_TOKEN="freecc"

# Unused messaging platform (Discord/Telegram bot — we don't use this)
MESSAGING_PLATFORM="discord"
MESSAGING_RATE_LIMIT=1
