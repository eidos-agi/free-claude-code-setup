#!/usr/bin/env python3
"""claude-nim-usage — summarize requests logged by the proxy's usage middleware.

Reads ~/.cache/nim-proxy-usage.jsonl (one JSON object per line: ts, path, status, dur_ms)
and prints daily/weekly/total counts + status breakdown + latency percentiles.

Usage:
  claude-nim-usage               # default: last 7 days
  claude-nim-usage --days 30
  claude-nim-usage --today
  claude-nim-usage --json        # machine-readable
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

DEFAULT_LOG = Path(os.path.expanduser("~/.cache/nim-proxy-usage.jsonl"))


def load(path: Path) -> list[dict]:
    if not path.exists():
        return []
    entries = []
    with path.open() as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    return entries


def pctile(values: list[int], p: float) -> int:
    if not values:
        return 0
    values = sorted(values)
    k = min(len(values) - 1, int(p / 100 * len(values)))
    return values[k]


def summarize(entries: list[dict], since: datetime | None = None) -> dict:
    filtered = []
    for e in entries:
        try:
            ts = datetime.fromisoformat(e["ts"].replace("Z", "+00:00"))
        except (KeyError, ValueError):
            continue
        if since and ts < since:
            continue
        filtered.append({**e, "_ts": ts})

    by_day = defaultdict(int)
    status_counts = Counter()
    model_counts = Counter()
    durs = []
    input_tokens_total = 0
    output_tokens_total = 0
    requests_with_tokens = 0
    for e in filtered:
        day = e["_ts"].astimezone(timezone.utc).strftime("%Y-%m-%d")
        by_day[day] += 1
        status_counts[e.get("status", "?")] += 1
        model_counts[e.get("model") or "<unknown>"] += 1
        if isinstance(e.get("dur_ms"), int):
            durs.append(e["dur_ms"])
        it = e.get("input_tokens")
        ot = e.get("output_tokens")
        if isinstance(it, int) or isinstance(ot, int):
            requests_with_tokens += 1
            if isinstance(it, int):
                input_tokens_total += it
            if isinstance(ot, int):
                output_tokens_total += ot

    return {
        "total": len(filtered),
        "by_day": dict(sorted(by_day.items())),
        "status": dict(status_counts),
        "model": dict(model_counts.most_common()),
        "dur_ms_p50": pctile(durs, 50),
        "dur_ms_p95": pctile(durs, 95),
        "dur_ms_avg": int(sum(durs) / len(durs)) if durs else 0,
        "input_tokens": input_tokens_total,
        "output_tokens": output_tokens_total,
        "total_tokens": input_tokens_total + output_tokens_total,
        "requests_with_tokens": requests_with_tokens,
    }


def print_human(summary: dict, label: str) -> None:
    print(f"=== {label} ===")
    print(f"  total requests : {summary['total']}")
    if summary["status"]:
        status_str = ", ".join(f"{k}:{v}" for k, v in sorted(summary["status"].items()))
        print(f"  by status      : {status_str}")
    print(f"  latency (ms)   : avg {summary['dur_ms_avg']}  p50 {summary['dur_ms_p50']}  p95 {summary['dur_ms_p95']}")
    if summary.get("model"):
        model_str = ", ".join(f"{k}:{v}" for k, v in summary["model"].items())
        print(f"  by model       : {model_str}")
    # Token totals (from NVIDIA's usage counts in the response stream)
    if summary.get("total_tokens", 0) > 0 or summary.get("requests_with_tokens", 0) > 0:
        covered = summary.get("requests_with_tokens", 0)
        total_req = summary["total"]
        cov_pct = int(100 * covered / total_req) if total_req else 0
        print(f"  NVIDIA tokens  : {summary['input_tokens']:>7,} in + {summary['output_tokens']:>7,} out = {summary['total_tokens']:>7,} total ({covered}/{total_req} reqs = {cov_pct}% covered)")
    if summary["by_day"]:
        print("  by day:")
        for day, n in summary["by_day"].items():
            bar = "█" * min(40, n)
            print(f"    {day}  {n:>4}  {bar}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--days", type=int, default=7, help="days back to include (default 7)")
    parser.add_argument("--today", action="store_true", help="only today")
    parser.add_argument("--all", action="store_true", help="all history")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--log", type=Path, default=DEFAULT_LOG)
    args = parser.parse_args()

    entries = load(args.log)
    if not entries:
        print(f"no entries in {args.log}", file=sys.stderr)
        print("  (is the proxy running the usage_logger middleware? try `claude-nim -p hi` first)", file=sys.stderr)
        return 1

    now = datetime.now(timezone.utc)
    if args.today:
        since = now.replace(hour=0, minute=0, second=0, microsecond=0)
        label = f"today ({since.strftime('%Y-%m-%d')})"
    elif args.all:
        since = None
        label = "all time"
    else:
        since = now - timedelta(days=args.days)
        label = f"last {args.days} days"

    summary = summarize(entries, since=since)

    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print_human(summary, label)
    return 0


if __name__ == "__main__":
    sys.exit(main())
