#!/usr/bin/env bash
# stop-nim-proxy — terminate the NIM proxy listening on :8082 (or $NIM_PROXY_PORT).
set -eu

PORT=${NIM_PROXY_PORT:-8082}

reachable() {
    local code
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 \
        "http://localhost:${PORT}/" 2>/dev/null) || code="000"
    [ "$code" != "000" ] && [ -n "$code" ]
}

if ! reachable; then
    echo "[stop-nim-proxy] nothing reachable on :${PORT}" >&2
    exit 0
fi

# WSL1's /proc/net is per-session, so we can't reliably find the proxy's PID from
# here. The surest portable way to stop it is to shut WSL down entirely —
# Windows owns the socket, WSL owns the process, and `wsl --shutdown` halts both.
echo "[stop-nim-proxy] shutting down WSL to stop the proxy..."
/mnt/c/Windows/System32/wsl.exe --shutdown 2>/dev/null || wsl.exe --shutdown
sleep 1
if reachable; then
    echo "[stop-nim-proxy] WARN: proxy still reachable after WSL shutdown" >&2
    exit 1
fi
echo "[stop-nim-proxy] done"
