#!/usr/bin/env bash
# check-nim — run the NIM setup health-check suite.
# Usage:  check-nim          (normal — exits 0 if all critical checks pass)
#         check-nim --verbose (also show values/traffic counts)
# Safe to run at any time. Uses no API requests unless --live is passed.
set -u

PORT=${NIM_PROXY_PORT:-8082}
VERBOSE=0
LIVE=0
for arg in "$@"; do
    case "$arg" in
        -v|--verbose) VERBOSE=1 ;;
        -l|--live)    LIVE=1 ;;
        -h|--help)
            sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
    esac
done

pass=0
fail=0
warn=0

ok()   { printf "  \033[32m✓\033[0m  %s\n" "$1"; pass=$((pass+1)); }
bad()  { printf "  \033[31m✗\033[0m  %s\n" "$1"; [ $# -ge 2 ] && printf "      %s\n" "$2"; fail=$((fail+1)); }
note() { printf "  \033[33m!\033[0m  %s\n" "$1"; [ $# -ge 2 ] && printf "      %s\n" "$2"; warn=$((warn+1)); }
sect() { printf "\n\033[1m%s\033[0m\n" "$1"; }

#── 1. Proxy health ──────────────────────────────────────────────────────────
sect "1. Proxy"
proxy_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "http://localhost:${PORT}/" 2>/dev/null || echo "000")
case "$proxy_code" in
    000) bad "Proxy not reachable on localhost:${PORT}" "Run 'claude-nim --version' to start it, or check /tmp/nim-proxy.log" ;;
    401) ok "Proxy listening on :${PORT} (HTTP 401 from anonymous GET = healthy)" ;;
    *)   note "Proxy responded on :${PORT} but with unexpected status ${proxy_code}" "Expected 401 on anonymous GET /" ;;
esac

models_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 -H "x-api-key: freecc" "http://localhost:${PORT}/v1/models" 2>/dev/null || echo "000")
if [ "$models_code" = "200" ]; then
    ok "/v1/models returns 200 with auth token"
elif [ "$proxy_code" = "000" ]; then
    :  # already reported
else
    bad "/v1/models returned ${models_code} (expected 200 with 'x-api-key: freecc')" "Auth token mismatch — check ANTHROPIC_AUTH_TOKEN in .env"
fi

#── 2. Launchers ─────────────────────────────────────────────────────────────
sect "2. Launchers"
if command -v claude-nim >/dev/null 2>&1; then
    loc=$(command -v claude-nim)
    ok "claude-nim resolves to: $loc"
else
    bad "claude-nim not on PATH" "Expected /usr/local/bin/claude-nim symlink"
fi
if command -v stop-nim-proxy >/dev/null 2>&1; then
    ok "stop-nim-proxy resolves to: $(command -v stop-nim-proxy)"
else
    bad "stop-nim-proxy not on PATH"
fi
if [ -x /mnt/c/Users/Shadow/AppData/Roaming/npm/claude.cmd ]; then
    ok "Windows claude.cmd exists at expected path"
else
    bad "Windows claude.cmd missing" "bash launcher hardcodes this path — reinstall Claude Code on Windows"
fi

#── 3. Upstream proxy repo + config ──────────────────────────────────────────
sect "3. Upstream proxy (/root/repos/free-claude-code)"
if [ -d /root/repos/free-claude-code ]; then
    ok "Proxy repo exists"
else
    bad "Proxy repo missing at /root/repos/free-claude-code"
fi
if [ -f /root/repos/free-claude-code/.env ]; then
    perms=$(stat -c %a /root/repos/free-claude-code/.env 2>/dev/null)
    if [ "$perms" = "600" ]; then
        ok ".env present, perms 600"
    else
        note ".env perms are $perms (expected 600)" "chmod 600 /root/repos/free-claude-code/.env"
    fi
    if grep -q '^NVIDIA_NIM_API_KEY="nvapi-' /root/repos/free-claude-code/.env; then
        ok "NVIDIA_NIM_API_KEY present and well-formed"
    else
        bad "NVIDIA_NIM_API_KEY missing or malformed in .env"
    fi
else
    bad ".env missing — copy from env.template and fill in NIM key"
fi

#── 4. Isolated profile (Windows-side) ───────────────────────────────────────
sect "4. Isolated profile"
ISO=/mnt/c/Users/Shadow/AppData/Local/claude-nim-profile
if [ -d "$ISO/.claude" ]; then
    ok "Isolated profile exists at $ISO/.claude"
    if [ -f "$ISO/.claude/.credentials.json" ]; then
        bad "ISOLATED profile has .credentials.json!" "This means a real login leaked here. Delete it: rm '$ISO/.claude/.credentials.json'"
    else
        ok "No stored credentials in isolated profile (env-var auth will win)"
    fi
else
    note "Isolated profile not yet created" "First run of claude-nim will create it"
fi

#── 5. Recent proxy traffic (proof-of-routing, optional) ─────────────────────
sect "5. Recent proxy traffic"
if [ -f /tmp/nim-proxy.log ]; then
    posts=$(grep -c "POST /v1/messages" /tmp/nim-proxy.log 2>/dev/null || echo 0)
    if [ "$posts" -gt 0 ]; then
        ok "$posts POST /v1/messages entries in /tmp/nim-proxy.log (proxy IS seeing inference traffic)"
        [ "$VERBOSE" = "1" ] && tail -5 /tmp/nim-proxy.log | sed 's/^/      /'
    else
        note "0 POST /v1/messages in log — proxy may be running but hasn't served inference yet" "Run: claude-nim -p 'hi' --model claude-haiku-4-20250514 ; then re-check"
    fi
else
    note "/tmp/nim-proxy.log not found" "Was the proxy started with tee? Check the launcher"
fi

#── 6. Live inference test (only with --live) ────────────────────────────────
if [ "$LIVE" = "1" ] && [ "$proxy_code" = "401" ]; then
    sect "6. Live inference (uses 1 request of 40/min quota)"
    resp=$(curl -s --max-time 20 -X POST "http://localhost:${PORT}/v1/messages" \
        -H "x-api-key: freecc" -H "anthropic-version: 2023-06-01" -H "content-type: application/json" \
        -d '{"model":"claude-haiku-4-20250514","max_tokens":5,"stream":false,"messages":[{"role":"user","content":"ping"}]}' 2>/dev/null)
    served_model=$(printf '%s' "$resp" | grep -oE '"model":\s*"[^"]+"' | head -1 | cut -d'"' -f4)
    if [ -n "$served_model" ]; then
        ok "Live request routed — served by: $served_model"
    else
        bad "Live request failed" "Response: $(printf '%s' "$resp" | head -c 200)"
    fi
fi

#── Summary ─────────────────────────────────────────────────────────────────
sect "Summary"
printf "  %d passed, %d warnings, %d failed\n" "$pass" "$warn" "$fail"
[ "$fail" -eq 0 ] && exit 0 || exit 1
