#!/bin/bash
# git-credential-gh-exe — Linux git credential helper that reuses Windows gh.exe's stored token.
#
# Install:
#   sudo ln -sfn ~/repos/free-claude-code-setup/bin/git-credential-gh-exe /usr/local/bin/git-credential-gh-exe
#   git config --global credential.https://github.com.helper '/usr/local/bin/git-credential-gh-exe'
#
# Usage: called automatically by git during https github operations. Responds only to the
# 'get' action; 'store' and 'erase' are no-ops (token lives in gh.exe's keyring, not ours).
#
# Scope: only for github.com. Other hosts fall through to git's other configured helpers.

action="${1:-get}"

# Read git's request (key=value lines, blank line terminator)
declare -A req
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  req["$k"]="$v"
done

# Only answer for github.com
if [ "${req[host]:-}" != "github.com" ]; then
  exit 0
fi

case "$action" in
  get)
    token=$(gh.exe auth token 2>/dev/null | tr -d '\r\n ')
    if [ -n "$token" ]; then
      echo "username=x-access-token"
      echo "password=$token"
    fi
    ;;
  store|erase)
    # No-op: gh.exe owns the token lifecycle
    ;;
esac
